{
  "name": "clod-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:staged": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:fast": "bun test --bail --path-ignore-patterns=apps/web/tests/dom/** --path-ignore-patterns=tests/e2e/**",
    "test:deep": "bun test --path-ignore-patterns=apps/web/tests/dom/** --path-ignore-patterns=tests/e2e/**",
    "test:nightly": "bun test --path-ignore-patterns=apps/web/tests/dom/** --path-ignore-patterns=tests/e2e/**",
    "web:test": "bun run --filter @clod-ui/web test",
    "ci:fast": "bun run scripts/ci.ts fast",
    "ci:deep": "bun run scripts/ci.ts deep",
    "ci:nightly": "bun run scripts/ci.ts nightly",
    "tape:record": "bun run packages/test-kit/bin/record-tape.ts",
    "start": "bun run apps/launcher/src/index.ts",
    "dev": "bun run --filter '*' dev"
  },
  "devDependencies": {
    "@clod-ui/test-kit": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@types/bun": "^1.1.14",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "lefthook": "^1.10.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
