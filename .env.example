# clod-ui environment variables. Copy to `.env` and edit; `.env` is gitignored.
# None of these are secrets — clod-ui holds no API keys. Authentication is the
# Claude Code CLI's own, stored under CLAUDE_HOME by `claude` itself.

# Where the engine keeps its app data (SQLite index + per-conversation manifests).
# Default: $HOME/.local/share/clod-ui
CLOD_UI_APP_DATA_DIR=

# Claude Code's home directory. The engine reads `settings.json` and tails
# `projects/<encoded-cwd>/<session-id>.jsonl` transcripts from here.
# Default: $HOME/.claude
CLAUDE_HOME=

# Engine HTTP/WS port. Default: 0 (kernel-assigned ephemeral port).
CLOD_UI_ENGINE_PORT=

# Web dev server: base URL of a separately-running engine.
# Default: same origin as the page.
VITE_ENGINE_URL=

# Emergency escape hatch for the `.bun-version` pin in scripts/ci.ts.
# Set to `off` for local debug only; never in CI.
CLOD_UI_BUN_GUARD=
